type ReferringOrganisation {
    id: ID
    name: String
    website: String
    phoneNumber: String
    requestCount: Int
    archived: Boolean
    createdAt: String
    updatedAt: String
    referringOrganisationContacts: [ReferringOrganisationContact]
    membershipTier: MembershipTier!
    "Plain YYYY-MM-DD start of a paid membership (a London calendar date). Ignored for FREE"
    membershipStartDate: String!
    "Plain YYYY-MM-DD last day of a paid membership; null when unset. A FREE organisation may hold a stale value: ignore it"
    membershipEndDate: String
    "The current membership year and how much of the allowance is used (see membership.graphqls)"
    membership: Membership!
    "Non-archived referees flagged as membership contacts"
    membershipContacts: [ReferringOrganisationContact!]!
}

"A representation of a page result from a query"
type ReferringOrganisationPage {
    "The list of deals retrieved from the server"
    content: [ReferringOrganisation!]
    "The number of total pages"
    totalPages: Int
    "The total amount of elements in this request"
    totalElements: Int
    "The size of the current page"
    size: Int
    "Returns whether the current page is the first"
    first: Boolean
    "Returns whether the current page is the last"
    last: Boolean
    "Returns if there is a next page"
    hasNext: Boolean
    "Returns if there is a previous page"
    hasPrevious: Boolean
    "Number of elements in current slice"
    numberOfElements: Int
    "Returns whether the page has content at all"
    hasContent: Boolean
    "The number of the current page"
    number: Int
}

type ReferringOrganisationPublic {
    id: ID
    name: String
}

input CreateReferringOrganisationInput {
    name: String
    website: String
    phoneNumber: String
}

input UpdateReferringOrganisationInput {
    id: ID
    name: String
    website: String
    phoneNumber: String
    archived: Boolean
    "Null or absent leaves the tier unchanged"
    membershipTier: MembershipTier
    "YYYY-MM-DD. Null or absent leaves the start date unchanged"
    membershipStartDate: String
    "YYYY-MM-DD. Null or absent leaves the end date unchanged. Defaults to start + 1 year - 1 day when the start is set or a paid tier begins"
    membershipEndDate: String
}

input ReferringOrganisationWhereInput {
    id: LongComparison
    name: TextComparison
    website: TextComparison
    archived: BooleanComparison
    membershipTier: MembershipTierComparison
    """
    Near or at the allowance (see MembershipUsageBand). Honoured by referringOrganisations and
    referringOrganisationsConnection only; anywhere else this input is nested it is an error.
    """
    membershipUsage: MembershipUsageBandComparison
    createdAt: TimeComparison
    updatedAt: TimeComparison
    AND: [ReferringOrganisationWhereInput!]
    OR: [ReferringOrganisationWhereInput!]
    NOT: [ReferringOrganisationWhereInput!]
}

"""
An organisation as it stood at one audit revision. Deliberately flat: no referees, notes, request
counts or live allowance, so reading history cannot reach anything but the organisation's own
audited columns. The membership fields are null on revisions written before membership existed
(2026-10-28) and on a DEL revision.
"""
type ReferringOrganisationSnapshot {
    id: ID
    name: String
    website: String
    phoneNumber: String
    archived: Boolean
    "The STORED tier at that revision (not the effective one)"
    membershipTier: MembershipTier
    membershipStartDate: String
    membershipEndDate: String
}

type ReferringOrganisationRevision {
    entity: ReferringOrganisationSnapshot
    revision: CustomRevisionInfo
    "ADD, MOD or DEL"
    type: String
}

"Restricted filter surface for the anonymous referringOrganisationsPublic query"
input ReferringOrganisationPublicWhereInput {
    name: TextComparison
    archived: BooleanComparison
}


extend type Query {
    referringOrganisationsConnection(page: PaginationInput, where: ReferringOrganisationWhereInput): ReferringOrganisationPage
    referringOrganisationsPublic(where: ReferringOrganisationPublicWhereInput!, orderBy: [KeyValuePair!]): [ReferringOrganisationPublic]
    referringOrganisations(where: ReferringOrganisationWhereInput!, orderBy: [KeyValuePair!]): [ReferringOrganisation!]!
    referringOrganisation(where: ReferringOrganisationWhereInput!): ReferringOrganisation
    "Audit history of one organisation, oldest first. Needs app:admin or admin:organisations (#266)"
    referringOrganisationAudits(where: Long!): [ReferringOrganisationRevision!]
}

extend type Mutation {
    createReferringOrganisation(data: CreateReferringOrganisationInput!) : ReferringOrganisation!
    updateReferringOrganisation(data: UpdateReferringOrganisationInput!): ReferringOrganisation!
    deleteReferringOrganisation(id: ID!): Boolean
}
