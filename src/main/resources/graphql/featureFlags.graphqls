"A named on/off switch controlling optional functionality."
type FeatureFlag {
    "Stable identifier, e.g. \"delivery-booking\""
    key: String
    enabled: Boolean
    updatedAt: String
}

input UpdateFeatureFlagInput {
    key: String!
    enabled: Boolean!
}

extend type Query {
    "Public: feature flags an unauthenticated page may need to gate itself. No auth required."
    featureFlagsPublic: [FeatureFlag!]!
    "All feature flags (admin)."
    featureFlags: [FeatureFlag!]!
}

extend type Mutation {
    "Create or update a feature flag (admin)."
    updateFeatureFlag(data: UpdateFeatureFlagInput!): FeatureFlag!
}
