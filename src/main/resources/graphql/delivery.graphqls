"A delivery time window on a given delivery day (e.g. a morning or afternoon slot)."
type DeliveryWindow {
    id: ID
    name: String
    "Display-formatted start time, e.g. \"10:00am\""
    startTime: String
    "Display-formatted end time, e.g. \"1:00pm\""
    endTime: String
    "Emoji shown next to the window in the booking UI"
    icon: String
}

"How much room is left in a window on a particular day."
type DeliveryWindowAvailability {
    window: DeliveryWindow
    spotsRemaining: Int
}

"A bookable delivery day and the availability of each of its windows."
type DeliveryDayAvailability {
    "ISO date, e.g. \"2026-07-16\""
    date: String
    "Full day name, e.g. \"Tuesday\""
    dayOfWeek: String
    "Human label, e.g. \"Tuesday 16 July\""
    dayLabel: String
    windows: [DeliveryWindowAvailability!]!
}

"The details a member of the public submits to book a delivery slot."
input DeliveryBookingInput {
    "ISO date of the chosen delivery day"
    date: String!
    "ID of the chosen delivery window"
    windowId: ID!
    firstName: String!
    surname: String!
    email: String!
    phone: String!
    address: String!
    accessNotes: String
    "The client's CTA reference number — their device request id"
    ctaReference: Long!
    "Cloudflare Turnstile token proving the submitter is human; required only when Turnstile is enabled"
    turnstileToken: String
}

"Confirmation returned after a delivery slot is successfully booked."
type DeliveryBookingConfirmation {
    id: ID
    date: String
    dayLabel: String
    window: DeliveryWindow
    address: String
    ctaReference: Long
    "The email address the confirmation was sent to"
    confirmationSentTo: String
}

"Whether a CTA reference is currently eligible to book a delivery."
type DeliveryBookingEligibility {
    eligible: Boolean!
    "Set only when ineligible. Deliberately identical for an unknown reference and a reference in the wrong status."
    message: String
}

extend type Query {
    """
    Public: upcoming delivery days and remaining capacity per window. No auth required.
    ctaReference is optional; when supplied and borough scheduling is enabled, days restricted
    away from the reference's borough are omitted.
    """
    deliveryAvailabilityPublic(ctaReference: Long): [DeliveryDayAvailability!]!
    "Public: whether a CTA reference can currently book a delivery. No auth required, rate-limited per IP."
    deliveryBookingEligibilityPublic(ctaReference: Long!): DeliveryBookingEligibility!
}

extend type Mutation {
    "Public: book a delivery slot. No auth required."
    submitDeliveryBookingPublic(input: DeliveryBookingInput!): DeliveryBookingConfirmation!
}
