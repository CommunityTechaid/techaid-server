type AdminConfig {
    id: ID!
    canPublicRequestSIMCard: Boolean
    canPublicRequestLaptop: Boolean
    canPublicRequestPhone: Boolean
    canPublicRequestBroadbandHub: Boolean
    canPublicRequestTablet: Boolean
    canPublicRequestDesktop: Boolean
    createdAt: String
    updatedAt: String
    "What happens to a request once an organisation's membership allowance is used up. Readable anonymously."
    membershipOverLimitMode: MembershipOverLimitMode
    "Requests accepted past the cap in GRACE mode. Readable anonymously."
    membershipGraceRequests: Int
}

input UpdateAdminConfigInput {
    canPublicRequestSIMCard: Boolean
    canPublicRequestLaptop: Boolean
    canPublicRequestPhone: Boolean
    canPublicRequestBroadbandHub: Boolean
    canPublicRequestTablet: Boolean
    canPublicRequestDesktop: Boolean
    "Null or absent leaves the value unchanged"
    membershipOverLimitMode: MembershipOverLimitMode
    "Null or absent leaves the value unchanged. Must be 0 or more"
    membershipGraceRequests: Int
}

extend type Query {
    adminConfig: AdminConfig
}

# The base declaration of the root Mutation type. Every other domain file uses
# `extend type Mutation`, and one file has to declare it. This one is an arbitrary but
# deliberate choice - admin config is the least domain-specific of the candidates - and it can
# be moved to any of them without changing the assembled schema. See root.graphqls.
type Mutation {
    updateAdminConfig(data: UpdateAdminConfigInput): AdminConfig
}

