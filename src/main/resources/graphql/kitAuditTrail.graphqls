
type CustomRevisionInfo {
    id: Long,
    timestamp: Long,
    customUser: String
}

enum RevisionType {
    ADD, DEL, MOD
}

type KitRevision {
    entity: Kit
    revision: CustomRevisionInfo,
    type: String
    """
    True when this revision changed no audited column except updatedAt - the row records that
    the device was written, not that anything about it moved.

    Read it together with siblingKitsInRevision. Both true and non-zero together is #148
    collateral: the device was dragged into someone else's transaction and rewritten untouched.
    True with zero siblings is a real edit to KitAttributes (notes, state, credentials,
    network), which is @NotAudited and so invisible here - do not hide those.
    """
    changedNothingAudited: Boolean!
    """
    How many OTHER kits were written in the same revision. Zero for an ordinary single-device
    edit. 83,179 audit rows carry a non-zero value here from #148, one revision of which
    rewrote 2,927 kits at once.
    """
    siblingKitsInRevision: Int!
}

"A representation of a page result from a query"
type KitRevisionPage {
    "The list of deals retrieved from the server"
    content: [KitRevision!]
    "The number of total pages"
    totalPages: Int
    "The total amount of elements in this request"
    totalElements: Int
    "The size of the current page"
    size: Int
    "Returns whether the current page is the first"
    first: Boolean
    "Returns whether the current page is the last"
    last: Boolean
    "Returns if there is a next page"
    hasNext: Boolean
    "Returns if there is a previous page"
    hasPrevious: Boolean
    "Number of elements in current slice"
    numberOfElements: Int
    "Returns whether the page has content at all"
    hasContent: Boolean
    "The number of the current page"
    number: Int
}

extend type Query {
    kitAudits(where: Long!): [KitRevision!]
}