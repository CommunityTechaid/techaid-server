<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Preserve existing Spring Boot console logging for all app logs -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <!--
        Dedicated JSON appender for HTTP access logs.
        Each request produces one JSON line on stdout containing all standard
        access log fields (timestamp, method, path, status, IPs, sizes, duration).
        Docker captures stdout, so Azure Monitor Agent / Log Analytics can ingest these
        by collecting container logs from the Azure VM.
        Identify access log lines in Log Analytics via: where logger_s == "cta.access"
    -->
    <appender name="ACCESS_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeCallerData>false</includeCallerData>
            <fieldNames>
                <timestamp>timestamp</timestamp>
                <message>message</message>
                <logger>logger</logger>
                <level>level</level>
                <thread>[ignore]</thread>
                <version>[ignore]</version>
            </fieldNames>
        </encoder>
    </appender>

    <!--
        Access logger: JSON only, not forwarded to root (avoids duplicate lines).

        Level is DEBUG deliberately, and must stay in step with the accessLogger.debug(...) call
        site in RequestFilterConfig. The Application Insights Java agent captures logs at INFO and
        above (instrumentation.logging.level in applicationinsights.json), so holding the access
        log at DEBUG keeps it on stdout — where ContainerAppConsoleLogs_CL collects it — while
        keeping it out of AppTraces, which it was otherwise flooding at ~13k rows/week (69% of all
        production AppTraces rows) purely as a duplicate of the console copy.

        This logger carries an explicit level, so it does NOT inherit logging.level.cta from
        application.yml and is unaffected by changes to it. Changing the level here without also
        changing the call site (or vice versa) silently disables the access log everywhere;
        AccessLogEmissionTest guards that.
    -->
    <logger name="cta.access" level="DEBUG" additivity="false">
        <appender-ref ref="ACCESS_JSON"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
