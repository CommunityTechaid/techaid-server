# Local development settings for `docker compose up`. Copy to `.env` (git-ignored) and fill in
# AUTH_ADMIN_SECRET. Everything else works as-is for a local stack.

# Auth0: the shared techaid-auth tenant. Tokens are validated against it; no secret needed.
AUTH0_AUDIENCE=https://api.communitytechaid.org.uk
AUTH0_DOMAIN=techaid-auth.eu.auth0.com
JWT_ISSUER=https://techaid-auth.eu.auth0.com/
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=https://techaid-auth.eu.auth0.com/
TOKEN_ATTRIBUTE=https://communitytechaid.org.uk

# Required - compose refuses to start while it is empty. Grants full authorities via the
# X-Auth-Admin-Secret header, so generate a long random local-only value
# (e.g. `openssl rand -hex 32`); never reuse the UAT/production value.
AUTH_ADMIN_SECRET=

# Local Postgres container. DB_PASS must match POSTGRES_PASSWORD in docker-compose.yml.
DB_URL=jdbc:postgresql://postgres:5432/techaid_api
DB_USER=postgres
DB_PASS=password

SPRING_PROFILES_ACTIVE=local

# Deliberately NOT set for local development:
#   AUTH0_CLIENT_ID / AUTH0_CLIENT_SECRET - Auth0 Management API credentials that can change users
#     and roles in the shared tenant. User-management screens will not work locally without them.
#   GMAIL_* - outbound email stays disabled (GMAIL_ENABLED defaults to false).
#   TYPEFORM_KEY - Typeform integration stays disabled.
TYPEFORM_KEY=
