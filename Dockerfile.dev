FROM eclipse-temurin:17

COPY ./ /app

WORKDIR /app

# Use the repo's Gradle wrapper, so this container builds with the same Gradle as CI and the
# shipped image. A Windows checkout can give gradlew CRLF line endings, which breaks it under sh.
# Fetch project dependencies
RUN sed -i 's/\r$//' gradlew start.sh && chmod +x gradlew start.sh && ./gradlew getDeps

# script which watches source file changes in background and executes bootRun
CMD ["tail", "-f", "/dev/null"]
